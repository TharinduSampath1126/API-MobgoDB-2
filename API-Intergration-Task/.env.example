# Example Frontend Environment Variables  
# Copy this to .env and replace with your actual values
# Note: All Vite env vars must start with VITE_

# AWS S3 Configuration
VITE_AWS_ACCESS_KEY_ID=your_aws_access_key_here
VITE_AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
VITE_AWS_BUCKET_NAME=your_bucket_name
VITE_AWS_REGION=us-east-1

# API Configuration
VITE_API_BASE_URL=http://localhost:5000/api
VITE_SECRET_API_BASE_URL=https://dummyjson.com/products

# App Configuration
VITE_APP_NAME=API Integration Task